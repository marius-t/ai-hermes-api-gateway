# Server
PORT=3000

# Static API token — clients send this to /login to obtain a session bearer <REDACTED>
API_TOKEN=your-api-token-here

# Session token returned by /login (issued to clients) AND accepted by protected routes
SESSION_TOKEN=your-session-token-here

# Hermes agent (HTTP API)
HERMES_BASE_URL=http://localhost:8000
HERMES_TIMEOUT_MS=120000
HERMES_RETRIES=2
